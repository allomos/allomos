#!/bin/sh
# After the Allomos .pkg installs the app (Task-A07-12): make `alm` work in every new terminal with
# a link /usr/local/bin/alm -> the alm inside Allomos.app, so updating the app updates alm too.
# One link, and the latest install wins (owner, 2026-10-14, Task-A07-15): whatever is there, a
# development build's link (scripts/install-dev-alm.sh) or anything else, now leads to this app.
app_alm="${2:-/Applications}/Allomos.app/Contents/MacOS/alm"
link=/usr/local/bin/alm
[ -x "$app_alm" ] || exit 0
mkdir -p /usr/local/bin
ln -sfn "$app_alm" "$link"
exit 0
